{
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "edit_predictions": {
    "mode": "subtle",
    "copilot": {
      "enable_next_edit_suggestions": false
    },
    "provider": "copilot"
  },
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "remote": false,
      "settings": {
        "context7_api_key": "ctx7sk-75b79033-65a5-4df8-b80a-e16257eb9524"
      }
    }
  },
  "which_key": {
    "enabled": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "agent_ui_font_family": ".ZedMono",
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "agent_ui_font_size": 14.0,
  "buffer_line_height": "comfortable",
  "diff_view_style": "unified",
  "disable_ai": false,
  "vim_mode": true,
  "base_keymap": "VSCode",
  "ui_font_weight": 150.0,
  "ui_font_family": "Hack Nerd Font Mono",
  "buffer_font_weight": 400.0,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 12.0,
  "buffer_font_size": 18.0,
  "relative_line_numbers": "enabled",
  "theme": "Ayu Light",
  "terminal": {
    "default_height": 500.0,
    "font_size": 20.0,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "proxy": "",
  "show_edit_predictions": false,
  "collaboration_panel": {
    "button": false
  },
  "chat_panel": {
    "button": "never"
  },
  "agent": {
    "default_model": {
      "provider": "google",
      "model": "gemini-3.7-flash",
      "enable_thinking": true,
      "effort": "medium"
    },
    "dock": "left"
  },
  "project_panel": {
    "git_status": true,
    "file_icons": true,
    "folder_icons": true,
    "hide_gitignore": false,
    "dock": "right",
    "button": true,
    "default_width": 200.0,
    "sort_mode": "directories_first",
    "git_status_indicator": false,
    "hide_root": true,
    "bold_folder_labels": false,
    "auto_reveal_entries": true,
    "indent_size": 25.0,
    "entry_spacing": "comfortable",
    "hide_hidden": true,
    "auto_fold_dirs": false,
  },
  "status_bar": {
    "line_endings_button": false,
    "show_active_file": false,
    "active_language_button": false,
    "experimental.show": true,
  },
  "minimap": {
    "show": "never",
  },
  "scrollbar": {
    "axes": {
      "vertical": false,
    },
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "colorize_brackets": false,
  "soft_wrap": "editor_width",
  "format_on_save": "off",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Catppuccin Latte"
  },
}
